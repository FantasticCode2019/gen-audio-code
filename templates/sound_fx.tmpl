<<define "sound_fx.curl">>
<<.CurlPreamble>>curl -X POST "<<.Endpoint>>" \
  -H "Authorization: Bearer <<.CurlAuth>>" \
  -H "Content-Type: application/json" \
  -d '{
    "model": "<<.Model>>",
    "input": "a short click of a wooden door latch"
  }' \
  --output sfx.wav
<<end>>

<<define "sound_fx.python">>
<<if .PyImportOS>>import os
<<end>>from pathlib import Path

import httpx

API_KEY = <<.PyAuth>>

resp = httpx.post(
    "<<.Endpoint>>",
    headers={"Authorization": f"Bearer {API_KEY}"},
    json={
        "model": "<<.Model>>",
        "input": "a short click of a wooden door latch",
    },
    timeout=180.0,
)
resp.raise_for_status()
Path("sfx.wav").write_bytes(resp.content)
<<end>>

<<define "sound_fx.typescript">>
import { writeFile } from "node:fs/promises";

const apiKey = <<.TSAuth>>;

const resp = await fetch("<<.Endpoint>>", {
  method: "POST",
  headers: {
    Authorization: `Bearer ${apiKey}`,
    "Content-Type": "application/json",
  },
  body: JSON.stringify({
    model: "<<.Model>>",
    input: "a short click of a wooden door latch",
  }),
});
if (!resp.ok) throw new Error(await resp.text());

await writeFile("sfx.wav", Buffer.from(await resp.arrayBuffer()));
<<end>>
