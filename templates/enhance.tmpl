<<define "enhance.curl">>
<<.CurlPreamble>>curl -X POST "<<.Endpoint>>" \
  -H "Authorization: Bearer <<.CurlAuth>>" \
  -F "model=<<.Model>>" \
  -F "file=@audio.mp3" \
  --output enhanced.wav
<<end>>

<<define "enhance.python">>
<<if .PyImportOS>>import os
<<end>>from pathlib import Path

import httpx

API_KEY = <<.PyAuth>>

resp = httpx.post(
    "<<.Endpoint>>",
    headers={"Authorization": f"Bearer {API_KEY}"},
    data={"model": "<<.Model>>"},
    files={"file": ("audio.mp3", open("audio.mp3", "rb"), "audio/mpeg")},
    timeout=180.0,
)
resp.raise_for_status()
Path("enhanced.wav").write_bytes(resp.content)
<<end>>

<<define "enhance.typescript">>
import { readFile, writeFile } from "node:fs/promises";

const apiKey = <<.TSAuth>>;

const fileBytes = await readFile("audio.mp3");
const form = new FormData();
form.set("model", "<<.Model>>");
form.set("file", new Blob([fileBytes], { type: "audio/mpeg" }), "audio.mp3");

const resp = await fetch("<<.Endpoint>>", {
  method: "POST",
  headers: { Authorization: `Bearer ${apiKey}` },
  body: form,
});
if (!resp.ok) throw new Error(await resp.text());

await writeFile("enhanced.wav", Buffer.from(await resp.arrayBuffer()));
<<end>>
